{
  "name": "cp-matchmaker",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/index.js",
    "dev": "npx tsx watch src/index.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/infrastructure/database/data_source.ts src/infrastructure/database/migrations/InitSchema",
    "migration:run": "npm run typeorm -- migration:run -d src/infrastructure/database/data_source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/infrastructure/database/data_source.ts",
    "script:seed": "npx tsx watch scripts/seedApps.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "typeorm": "^1.0.0"
  }
}
